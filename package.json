{
  "name": "x-reader",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop library and reflowable book reader.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-pdf.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "prebuild": "node scripts/prepare-pdf.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests *.ts scripts/*.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2",
    "fflate": "0.8.3",
    "foliate-js": "1.0.1",
    "lucide-react": "^0.577.0",
    "marked": "18.3.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.2"
  },
  "license": "MIT"
}
